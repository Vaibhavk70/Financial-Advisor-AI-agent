# ════════════════════════════════════════════
#   AI Financial Advisor — Environment Config
#   Copy this file to .env and fill in values
#   NEVER commit .env to Git!
# ════════════════════════════════════════════

# ─── PostgreSQL ──────────────────────────────
POSTGRES_USER=financeai
POSTGRES_PASSWORD=financeai_secret_change_in_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=financeai_db

# ─── Redis ───────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_change_in_prod
REDIS_DB=0

# ─── JWT / Auth ──────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-minimum-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── LLM Providers ───────────────────────────
# Get free key from: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Ollama (runs locally in Docker)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# ─── ChromaDB ────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ─── HuggingFace Embeddings ──────────────────
EMBEDDING_MODEL=BAAI/bge-m3

# ─── App Config ──────────────────────────────
DEBUG=false
# Comma-separated origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Monitoring ──────────────────────────────
GRAFANA_PASSWORD=admin_change_in_prod

# ─── Services (internal URLs) ────────────────
AUTH_SERVICE_URL=http://auth-service:8001
AGENT_SERVICE_URL=http://agent-service:8002
RAG_SERVICE_URL=http://rag-service:8003
MARKET_DATA_SERVICE_URL=http://market-data-service:8004
